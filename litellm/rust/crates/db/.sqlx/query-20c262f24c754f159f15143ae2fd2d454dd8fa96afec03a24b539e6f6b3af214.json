  "query": "SELECT e.user_id,\n       e.alias,\n       e.spend,\n       e.allowed_model_region,\n       e.default_model,\n       e.models,\n       e.budget_id,\n       e.object_permission_id,\n       e.blocked,\n       b.budget_id AS \"budget_budget_id?\",\n       b.name AS \"budget_name?\",\n       b.max_budget AS \"budget_max_budget?\",\n       b.soft_budget AS \"budget_soft_budget?\",\n       b.max_parallel_requests AS \"budget_max_parallel_requests?\",\n       b.tpm_limit AS \"budget_tpm_limit?\",\n       b.rpm_limit AS \"budget_rpm_limit?\",\n       b.tpd_limit AS \"budget_tpd_limit?\",\n       b.model_max_budget AS \"budget_model_max_budget?: RawJson\",\n       b.model_tpm_limit AS \"budget_model_tpm_limit?: RawJson\",\n       b.model_rpm_limit AS \"budget_model_rpm_limit?: RawJson\",\n       b.budget_duration AS \"budget_budget_duration?\",\n       b.budget_limits AS \"budget_budget_limits?: RawJson\",\n       b.cap_policy AS \"budget_cap_policy?\",\n       b.budget_reset_at AS \"budget_budget_reset_at?\",\n       b.budget_reset_count AS \"budget_budget_reset_count?\",\n       b.allowed_models AS \"budget_allowed_models?\",\n       b.temp_budget_increase AS \"budget_temp_budget_increase?\",\n       b.temp_budget_expiry AS \"budget_temp_budget_expiry?\",\n       b.created_at AS \"budget_created_at?\",\n       b.created_by AS \"budget_created_by?\",\n       b.updated_at AS \"budget_updated_at?\",\n       b.updated_by AS \"budget_updated_by?\",\n       p.object_permission_id AS \"permission_object_permission_id?\",\n       p.mcp_servers AS \"permission_mcp_servers?\",\n       p.mcp_access_groups AS \"permission_mcp_access_groups?\",\n       p.mcp_tool_permissions AS \"permission_mcp_tool_permissions?: RawJson\",\n       p.vector_stores AS \"permission_vector_stores?\",\n       p.agents AS \"permission_agents?\",\n       p.agent_access_groups AS \"permission_agent_access_groups?\",\n       p.models AS \"permission_models?\",\n       p.blocked_tools AS \"permission_blocked_tools?\",\n       p.mcp_toolsets AS \"permission_mcp_toolsets?\",\n       p.search_tools AS \"permission_search_tools?\",\n       p.mcp_tool_search_enabled AS \"permission_mcp_tool_search_enabled?\",\n       p.skills AS \"permission_skills?\"\nFROM \"LiteLLM_EndUserTable\" AS e\nLEFT JOIN \"LiteLLM_BudgetTable\" AS b ON b.budget_id = e.budget_id\nLEFT JOIN \"LiteLLM_ObjectPermissionTable\" AS p ON p.object_permission_id = e.object_permission_id\nWHERE e.user_id = $1\n",
