  "query": "SELECT tm.user_id,\n       tm.team_id,\n       tm.budget_id,\n       tm.spend,\n       tm.total_spend,\n       b.budget_id AS \"b_budget_id?\",\n       b.name AS \"b_name?\",\n       b.max_budget AS \"b_max_budget?\",\n       b.soft_budget AS \"b_soft_budget?\",\n       b.max_parallel_requests AS \"b_max_parallel_requests?\",\n       b.tpm_limit AS \"b_tpm_limit?\",\n       b.rpm_limit AS \"b_rpm_limit?\",\n       b.tpd_limit AS \"b_tpd_limit?\",\n       b.model_max_budget AS \"b_model_max_budget?: RawJson\",\n       b.model_tpm_limit AS \"b_model_tpm_limit?: RawJson\",\n       b.model_rpm_limit AS \"b_model_rpm_limit?: RawJson\",\n       b.budget_duration AS \"b_budget_duration?\",\n       b.budget_limits AS \"b_budget_limits?: RawJson\",\n       b.cap_policy AS \"b_cap_policy?\",\n       b.budget_reset_at AS \"b_budget_reset_at?\",\n       b.budget_reset_count AS \"b_budget_reset_count?\",\n       COALESCE(b.allowed_models, '{}') AS \"b_allowed_models?\",\n       b.temp_budget_increase AS \"b_temp_budget_increase?\",\n       b.temp_budget_expiry AS \"b_temp_budget_expiry?\",\n       b.created_at AS \"b_created_at?\",\n       b.created_by AS \"b_created_by?\",\n       b.updated_at AS \"b_updated_at?\",\n       b.updated_by AS \"b_updated_by?\"\nFROM \"LiteLLM_TeamMembership\" AS tm\nLEFT JOIN \"LiteLLM_BudgetTable\" AS b ON b.budget_id = tm.budget_id\nWHERE tm.user_id = $1 AND tm.team_id = $2\n",
